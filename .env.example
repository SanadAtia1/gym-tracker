# Copy to .env for local development:
#   cp .env.example .env
# On your host, set these in the platform env UI. Do not commit .env.

PORT=3000
NODE_ENV=development

# Public site URL used in verification and password-reset emails.
# Local: http://localhost:3000
# Production: https://yourdomain.com  (https required when NODE_ENV=production)
APP_URL=http://localhost:3000

# Set true on most PaaS / reverse-proxy hosts so rate limits use real client IPs.
TRUST_PROXY=false

# Optional. Defaults to gym.db next to the app.
# DB_PATH=/var/data/gym.db

# Required when NODE_ENV=production. Create a key at https://resend.com
# and verify the sending domain used in EMAIL_FROM.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Gym Tracker <verify@yourdomain.com>"
